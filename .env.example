# ── Core ─────────────────────────────────────────────────────────────────────
# Postgres connection. `npm run db:up` starts one in Docker with these credentials.
DATABASE_URL="postgresql://retrofit:retrofit@localhost:5432/retrofit?schema=public"

# Signs the session cookie (JWT). At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-a-long-random-string-of-32-plus-chars"

# Public URL of the site (links in emails, Stripe redirects, metadata)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Seed (npm run db:seed) ───────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@retrofitportal.co.uk"
SEED_ADMIN_PASSWORD="Admin123!"

# ── Stripe (optional in development) ─────────────────────────────────────────
# Leave empty in development: payments then succeed instantly so every flow works.
# The Premium Partner subscription price comes from settings (no Stripe price id needed).
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`, or the dashboard webhook.
STRIPE_WEBHOOK_SECRET=""

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Bearer token for /api/cron/billing (weekly invoices, reminders, holds). Run it hourly.
# On Vercel, setting CRON_SECRET is enough: vercel.json schedules it and Vercel sends the header.
CRON_SECRET=""

# ── AWS S3 (optional in development) ─────────────────────────────────────────
# Leave S3_BUCKET empty in development: uploads are stored in ./.uploads instead.
# Credentials come from the standard AWS chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, SSO, role…).
AWS_REGION="eu-west-2"
S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ── SendGrid (optional in development) ───────────────────────────────────────
# Leave empty to print emails (reset links, invites) to the server console.
SENDGRID_API_KEY=""
EMAIL_FROM="Retrofit Portal <no-reply@retrofitportal.co.uk>"
