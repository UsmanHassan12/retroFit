// Retrofit Portal — database schema (PostgreSQL 16+, Prisma 6).
// Conventions: ids are cuid strings, money is integer pence (`*Pence`), percentages are
// integer basis points (`*Bps`, 1000 = 10%), timestamps are UTC.
//
// Commercial rules follow "Draft Service Catalogue & Commercial Rules (for Dev)", 11 Nov 2026.
// Nothing commercial is hard-coded: services, prices, stages, intake questions, document
// lists, add-ons, bundles, billing cut-offs and hold rules are rows here or in `Setting`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  CLIENT
  ASSESSOR
  DESIGNER
  COORDINATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// Intake step 1 "customer type".
enum CustomerType {
  HOMEOWNER
  LANDLORD
  INSTALLER
  MANAGING_AGENT
  HOUSING_ASSOCIATION
  LOCAL_AUTHORITY
  BUSINESS
}

/// Basic = everyone; Premium Partner = approved, signed and subscribed partner.
enum CustomerTier {
  BASIC
  PARTNER
}

enum PartnerStatus {
  APPLIED
  /// Admin approved the application and set terms; waiting for signature + subscription.
  OFFERED
  ACTIVE
  SUSPENDED
  CANCELLED
  REJECTED
}

enum PaymentMode {
  /// Prepaid account credit.
  ADVANCE
  /// One VAT invoice per billing week.
  WEEKLY
}

enum ServiceCategory {
  ASSESSMENT
  DESIGN
  COORDINATION
  CALCULATIONS
  SURVEYS
  FUNDING
  COMPLIANCE
}

enum Scheme {
  ECO4
  GBIS
  WHLG
  SHDF
  PRIVATE
  OTHER
}

enum PriceUnit {
  PROPERTY
  ELEMENT
  JUNCTION
  VISIT
  PACKAGE
}

enum SiteVisit {
  NONE
  REQUIRED
  OPTIONAL
}

enum StageRole {
  ASSESSOR
  DESIGNER
  COORDINATOR
  ADMIN
}

enum AddonKind {
  /// `amount` is basis points of the line's list price (Express +30% = 3000).
  PERCENT_OF_LIST
  /// `amount` pence × quantity (additional site visit).
  PER_UNIT
  /// `amount` pence per mile beyond `freeAllowance` miles (travel).
  PER_MILE
  /// `amount` pence once per line.
  FIXED
}

enum AddonAudience {
  ALL
  BASIC
  PARTNER
}

enum IntakeFieldType {
  TEXT
  NUMBER
  SELECT
  MULTISELECT
  DATE
  FILE
  BOOLEAN
}

/// ORDER: asked once per booking (funding, installer, measures). LINE: per property/service.
enum IntakeScope {
  ORDER
  LINE
}

enum DocumentTiming {
  /// Needed before work starts; missing → project AWAITING_INFO.
  BEFORE_START
  /// Uploaded while works happen (installation photos); tracked, never blocking.
  DURING_WORK
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  /// Paid by card/credit, or accepted on a weekly invoice account.
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CARD
  CREDIT
  /// Account credit covers part, card pays the difference.
  CREDIT_AND_CARD
  WEEKLY_INVOICE
}

enum DiscountSource {
  NONE
  CODE
  PARTNER
}

enum ProjectStatus {
  AWAITING_PAYMENT
  AWAITING_INFO
  SCHEDULED
  IN_PROGRESS
  IN_QA
  DELIVERED
  REVISION
  COMPLETED
  ON_HOLD
  CANCELLED
}

/// Staff-set health shown in the admin donut and priority queue.
enum ProjectHealth {
  ON_TRACK
  AT_RISK
  DELAYED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  QA_REJECT
}

enum MilestoneStatus {
  DONE
  CURRENT
  UPCOMING
}

/// Task Board columns.
enum TaskColumn {
  BACKLOG
  AWAITING_CLIENT
  ASSESSMENT
  DESIGN
  COORDINATION
  QA
  DONE
}

enum VisitWindow {
  AM
  PM
}

enum VisitKind {
  INITIAL
  ADDITIONAL
  MID_INSTALL
  POST_INSTALL
}

enum VisitStatus {
  BOOKED
  COMPLETED
  NO_ACCESS
  CANCELLED
}

enum DocumentStatus {
  PENDING
  ACTIVE
}

enum DeliverableKind {
  PDF
  SPREADSHEET
  REPORT
}

enum DeliverableStatus {
  PENDING
  IN_PROGRESS
  AVAILABLE
}

enum DeliverableVersionLabel {
  INITIAL
  REVISED
  FINAL
}

enum RevisionStatus {
  REQUESTED
  ACCEPTED
  DECLINED
}

enum InvoiceKind {
  /// VAT receipt for one card / credit booking.
  ORDER
  /// Partner weekly invoice.
  WEEKLY
  /// Partner subscription (from Stripe).
  SUBSCRIPTION
  /// Receipt for an account-credit top-up.
  CREDIT_TOPUP
  /// Cancellation or failed-visit charge.
  CHARGE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

enum CreditEntryType {
  TOPUP
  DEDUCTION
  REFUND
  ADJUSTMENT
}

// ─── Identity ───────────────────────────────────────────────────────────────

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  passwordHash       String?
  firstName          String        @default("")
  lastName           String        @default("")
  phone              String?
  companyName        String?
  customerType       CustomerType?
  avatarUrl          String?
  role               Role          @default(CLIENT)
  status             UserStatus    @default(ACTIVE)
  /// Staff only: see every project, not just assigned ones ("View all projects").
  canViewAllProjects Boolean       @default(false)
  pushNotifications  Boolean       @default(true)
  stripeCustomerId   String?       @unique

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  /// Bumped on password change / logout-everywhere; sessions carrying an older value are rejected.
  sessionVersion   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partnerProfile      PartnerProfile?
  properties          Property[]
  orders              Order[]
  clientProjects      Project[]            @relation("ProjectClient")
  coordinatedProjects Project[]            @relation("ProjectCoordinator")
  memberships         ProjectMember[]
  assignedTasks       Task[]               @relation("TaskAssignee")
  createdTasks        Task[]               @relation("TaskCreator")
  documents           Document[]
  messages            Message[]
  activities          Activity[]
  invoices            Invoice[]
  creditEntries       CreditEntry[]        @relation("CreditOwner")
  holds               AccountHold[]        @relation("HoldOwner")
  availability        Availability[]
  visits              Visit[]
  passwordResets      PasswordResetToken[]
  invitesSent         Invite[]             @relation("InviteSender")
  auditLogs           AuditLog[]

  @@index([role, status])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invite {
  id                 String    @id @default(cuid())
  email              String
  role               Role
  canViewAllProjects Boolean   @default(false)
  projectIds         String[]
  tokenHash          String    @unique
  invitedById        String
  expiresAt          DateTime
  acceptedAt         DateTime?
  createdAt          DateTime  @default(now())

  invitedBy User @relation("InviteSender", fields: [invitedById], references: [id])

  @@index([email])
}

// ─── Premium Partners ───────────────────────────────────────────────────────

/// One per partner account (the doc's "userId or companyId": one login per company for now).
model PartnerProfile {
  id                  String        @id @default(cuid())
  userId              String        @unique
  companyName         String
  companyNumber       String?
  vatNumber           String?
  trustmarkLicence    String?
  status              PartnerStatus @default(APPLIED)
  /// Default discount on list prices, basis points (1000 = 10%).
  discountBps         Int           @default(1000)
  paymentMode         PaymentMode   @default(ADVANCE)
  /// Unbilled + unpaid work above this blocks new bookings. Null = no limit.
  creditLimitPence    Int?
  applicationNote     String?
  adminNotes          String?

  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?
  subscriptionRenewsAt DateTime?

  agreementVersion    String?
  agreementSignedAt   DateTime?
  agreementSignedName String?
  agreementSignedIp   String?

  appliedAt    DateTime  @default(now())
  approvedAt   DateTime?
  approvedById String?
  activatedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceDiscounts PartnerServiceDiscount[]

  @@index([status])
}

/// Per-service override of the partner's default discount.
model PartnerServiceDiscount {
  partnerId   String
  serviceId   String
  discountBps Int

  partner PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  service Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([partnerId, serviceId])
}

/// Prepaid credit ledger (Mode A). Balance = sum(amountPence); every row keeps the running balance.
model CreditEntry {
  id                    String          @id @default(cuid())
  userId                String
  type                  CreditEntryType
  /// Positive for top-ups/refunds, negative for deductions.
  amountPence           Int
  balanceAfterPence     Int
  orderId               String?
  /// VAT receipt for this movement.
  invoiceId             String?
  note                  String?
  stripePaymentIntentId String?         @unique
  createdById           String?
  createdAt             DateTime        @default(now())

  user    User     @relation("CreditOwner", fields: [userId], references: [id], onDelete: Cascade)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

/// Account hold: no new bookings, open work pauses, deliverables withheld.
model AccountHold {
  id         String    @id @default(cuid())
  userId     String
  reason     String
  invoiceId  String?
  /// Placed by the billing job (lifted automatically on payment) vs manually by an admin.
  automatic  Boolean   @default(true)
  startedAt  DateTime  @default(now())
  liftedAt   DateTime?
  liftedById String?
  liftReason String?

  user    User     @relation("HoldOwner", fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([userId, liftedAt])
}

// ─── Properties ─────────────────────────────────────────────────────────────

model Property {
  id                String   @id @default(cuid())
  ownerId           String
  /// Partner's own reference for the property (CSV import).
  label             String?
  uprn              String?
  line1             String
  line2             String?
  city              String
  postcode          String
  country           String   @default("United Kingdom")
  /// house / flat / bungalow / maisonette / park home (legacy free text accepted).
  propertyType      String
  /// detached / semi / mid-terrace / end-terrace
  builtForm         String?
  buildYear         Int?
  storeys           Int?
  bedrooms          Int?
  /// owner-occupied / private rented / social
  tenure            String?
  occupantName      String?
  occupantPhone     String?
  accessNotes       String?
  epcNumber         String?
  /// Storage key of the latest uploaded EPC certificate.
  epcCertificateKey String?
  verified          Boolean  @default(false)
  isPrimary         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  orderLines OrderLine[]
  projects   Project[]

  @@index([ownerId])
  @@index([postcode])
}

// ─── Service catalogue ──────────────────────────────────────────────────────

model Service {
  id             String          @id @default(cuid())
  /// Short code from the catalogue (RA, RD, RC…). Used in references and CSV imports.
  code           String          @unique
  slug           String          @unique
  /// Card title on listings.
  title          String
  /// H1 on the detail page.
  headline       String
  summary        String
  intro          String
  category       ServiceCategory
  badge          String          @default("PAS 2035")
  schemes        Scheme[]

  priceUnit      PriceUnit       @default(PROPERTY)
  /// List price per unit, excluding VAT.
  listPricePence Int
  siteVisit      SiteVisit       @default(NONE)
  /// Working days. Null when the turnaround isn't a fixed number (see the labels).
  standardDays   Int?
  /// Premium Partner (and Express) turnaround. 0 = same day when booked before the cut-off.
  fastTrackDays  Int?
  /// Overrides the generated text, e.g. "Runs to lodgement", "Agreed per audit".
  standardLabel  String?
  fastTrackLabel String?
  revisionRounds Int             @default(2)
  /// False = partner discounts and codes never apply.
  discountable   Boolean         @default(true)
  /// False for packages that aren't tied to one property (TrustMark Audit Support).
  requiresProperty Boolean       @default(true)

  imageUrl         String
  gallery          String[]
  /// { paragraphs: string[], keyAreas: string[] }
  overview         Json
  /// "What's Included" checklist.
  included         String[]
  /// [{ title, description, icon }]
  compliance       Json
  /// [{ title, description, icon }] shown on Review Order.
  deliverablesInfo Json
  active           Boolean  @default(true)
  position         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stages               ServiceStage[]
  documentRequirements ServiceDocumentRequirement[]
  deliverables         ServiceDeliverable[]
  questions            IntakeQuestion[]
  addons               ServiceAddon[]
  bundleItems          BundleItem[]
  partnerDiscounts     PartnerServiceDiscount[]
  orderLines           OrderLine[]
  projects             Project[]

  @@index([active, category])
}

/// Workflow stage. Becomes a ProjectMilestone (and a first task) when an order is confirmed.
model ServiceStage {
  id            String         @id @default(cuid())
  serviceId     String
  position      Int
  name          String
  description   String         @default("")
  clientVisible Boolean        @default(true)
  defaultRole   StageRole      @default(COORDINATOR)
  /// Target working days for this stage (milestone due date).
  slaDays       Int?
  /// Board column for the stage's task.
  boardColumn   TaskColumn     @default(BACKLOG)
  /// Project status entered when this stage becomes current (null = keep).
  projectStatus ProjectStatus?

  service    Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  milestones ProjectMilestone[]

  @@index([serviceId, position])
}

model ServiceDocumentRequirement {
  id            String         @id @default(cuid())
  serviceId     String
  key           String
  label         String
  required      Boolean        @default(true)
  /// Condition (see src/server/rules/conditions.ts). Null = always applies.
  condition     Json?
  timing        DocumentTiming @default(BEFORE_START)
  acceptedTypes String[]
  maxBytes      Int            @default(26214400)
  position      Int            @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, key])
}

model ServiceDeliverable {
  id          String          @id @default(cuid())
  serviceId   String
  name        String
  description String          @default("")
  kind        DeliverableKind @default(PDF)
  /// Goes through Initial → Revised → Final.
  versioned   Boolean         @default(true)
  position    Int             @default(0)

  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  deliverables Deliverable[]
}

/// Intake question. serviceId null = common question asked on every booking.
model IntakeQuestion {
  id        String          @id @default(cuid())
  serviceId String?
  key       String
  label     String
  help      String?
  type      IntakeFieldType
  /// [{ value, label }] for SELECT / MULTISELECT.
  options   Json?
  required  Boolean         @default(false)
  /// e.g. { "key": "scheme", "op": "eq", "value": "ECO4" }
  condition Json?
  scope     IntakeScope     @default(LINE)
  /// Intake step for common questions (5 funding, 6 installer, 7 measures…).
  step      Int             @default(0)
  position  Int             @default(0)
  active    Boolean         @default(true)

  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, position])
}

model ServiceAddon {
  id            String        @id @default(cuid())
  serviceId     String
  key           String
  name          String
  description   String        @default("")
  kind          AddonKind
  /// Pence, or basis points for PERCENT_OF_LIST.
  amount        Int
  /// PER_MILE: miles included before charging.
  freeAllowance Int           @default(0)
  audience      AddonAudience @default(ALL)
  /// Switches the line to the fast-track turnaround (Express delivery).
  fastTrack     Boolean       @default(false)
  icon          String        @default("express")
  active        Boolean       @default(true)
  position      Int           @default(0)

  service Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  lines   OrderLineAddon[]

  @@unique([serviceId, key])
}

/// Fixed-price bundle per property, e.g. Assessment + Design + Coordination.
model Bundle {
  id           String   @id @default(cuid())
  code         String   @unique
  slug         String   @unique
  name         String
  description  String   @default("")
  pricePence   Int
  discountable Boolean  @default(true)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items  BundleItem[]
  orders Order[]
}

model BundleItem {
  bundleId  String
  serviceId String
  position  Int    @default(0)

  bundle  Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@id([bundleId, serviceId])
}

model DiscountCode {
  id             String    @id @default(cuid())
  code           String    @unique
  percentOff     Int
  active         Boolean   @default(true)
  expiresAt      DateTime?
  maxRedemptions Int?
  redemptions    Int       @default(0)
  createdAt      DateTime  @default(now())

  orders Order[]
}

// ─── Scheduling ─────────────────────────────────────────────────────────────

/// Bookable visit capacity, per assessor, region (postcode area) and half-day window.
model Availability {
  id           String      @id @default(cuid())
  assessorId   String
  /// Postcode area, e.g. "M", "NW", "BS".
  regionPrefix String
  date         DateTime    @db.Date
  window       VisitWindow
  capacity     Int         @default(1)
  bookedCount  Int         @default(0)
  createdAt    DateTime    @default(now())

  assessor User    @relation(fields: [assessorId], references: [id], onDelete: Cascade)
  visits   Visit[]

  @@unique([assessorId, date, window])
  @@index([regionPrefix, date])
}

model Visit {
  id             String        @id @default(cuid())
  projectId      String
  availabilityId String?
  assessorId     String?
  date           DateTime      @db.Date
  window         VisitWindow
  kind           VisitKind     @default(INITIAL)
  status         VisitStatus   @default(BOOKED)
  notes          String?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  availability Availability? @relation(fields: [availabilityId], references: [id], onDelete: SetNull)
  assessor     User?         @relation(fields: [assessorId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([date])
}

/// England & Wales bank holidays, skipped when counting working days. Admin-editable.
model BankHoliday {
  date DateTime @id @db.Date
  name String
}

// ─── Orders & payments ──────────────────────────────────────────────────────

model Order {
  id            String         @id @default(cuid())
  reference     String         @unique
  userId        String
  status        OrderStatus    @default(DRAFT)
  customerTier  CustomerTier   @default(BASIC)
  paymentMethod PaymentMethod?
  bundleId      String?

  /// Answers to ORDER-scope intake questions (funding, installer, measures…).
  answers          Json     @default("{}")
  termsVersion     String
  termsAcceptedAt  DateTime
  gdprConsent      Boolean  @default(false)
  shareDataConsent Boolean  @default(false)
  consentIp        String?

  // Totals across lines (snapshots).
  listPence          Int
  discountPence      Int            @default(0)
  discountSource     DiscountSource @default(NONE)
  addonsPence        Int            @default(0)
  netPence           Int
  vatPence           Int
  totalPence         Int
  creditAppliedPence Int            @default(0)
  discountCodeId     String?

  stripeSessionId       String?   @unique
  stripePaymentIntentId String?
  confirmedAt           DateTime?
  paidAt                DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  bundle        Bundle?       @relation(fields: [bundleId], references: [id])
  discountCode  DiscountCode? @relation(fields: [discountCodeId], references: [id])
  lines         OrderLine[]
  invoiceLines  InvoiceLine[]
  creditEntries CreditEntry[]
  projects      Project[]

  @@index([userId, status])
  @@index([status, confirmedAt])
}

/// One service for one property (or one package). Each confirmed line becomes a project.
model OrderLine {
  id         String  @id @default(cuid())
  orderId    String
  serviceId  String
  propertyId String?
  position   Int     @default(0)

  // Snapshots so receipts never change when the catalogue does.
  serviceCode    String
  serviceTitle   String
  priceUnit      PriceUnit
  unitPricePence Int
  quantity       Int       @default(1)
  listPence      Int
  discountBps    Int       @default(0)
  discountPence  Int       @default(0)
  addonsPence    Int       @default(0)
  netPence       Int
  vatPence       Int
  totalPence     Int
  fastTrack      Boolean   @default(false)
  turnaroundDays Int?
  /// Answers to LINE-scope intake questions for this service.
  answers        Json      @default("{}")
  /// Visit slot the customer picked (capacity is taken when the order is confirmed).
  availabilityId String?
  createdAt      DateTime  @default(now())

  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service     Service          @relation(fields: [serviceId], references: [id])
  property    Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  addons      OrderLineAddon[]
  project     Project?
  invoiceLine InvoiceLine?

  @@index([orderId])
}

model OrderLineAddon {
  lineId      String
  addonId     String
  key         String
  name        String
  kind        AddonKind
  amount      Int
  quantity    Int    @default(1)
  totalPence  Int

  line  OrderLine    @relation(fields: [lineId], references: [id], onDelete: Cascade)
  addon ServiceAddon @relation(fields: [addonId], references: [id])

  @@id([lineId, addonId])
}

model Invoice {
  id          String        @id @default(cuid())
  /// INV-2026-0001
  number      String        @unique
  userId      String
  kind        InvoiceKind
  status      InvoiceStatus @default(ISSUED)
  description String
  periodStart DateTime?
  periodEnd   DateTime?

  subtotalPence Int
  vatPence      Int
  totalPence    Int
  vatRateBps    Int  @default(2000)
  /// Seller block printed on the VAT invoice (snapshot of the `seller` setting).
  seller        Json?

  issuedAt  DateTime  @default(now())
  dueAt     DateTime?
  paidAt    DateTime?
  /// CARD / BANK_TRANSFER / CREDIT / STRIPE_INVOICE
  paidVia   String?
  paidNote  String?
  /// Reminder keys already sent (see billing.reminders setting).
  remindersSent String[]

  stripeInvoiceId       String? @unique
  stripePaymentIntentId String?
  stripeSessionId       String? @unique
  pdfUrl                String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines         InvoiceLine[]
  creditEntries CreditEntry[]
  holds         AccountHold[]

  @@index([userId, issuedAt])
  @@index([status, dueAt])
  @@index([kind, periodEnd])
}

model InvoiceLine {
  id            String  @id @default(cuid())
  invoiceId     String
  orderId       String?
  /// A booking line appears on at most one weekly invoice.
  orderLineId   String? @unique
  description   String
  listPence     Int     @default(0)
  discountPence Int     @default(0)
  netPence      Int
  vatPence      Int
  totalPence    Int

  invoice   Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  order     Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderLine OrderLine? @relation(fields: [orderLineId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

// ─── Projects ───────────────────────────────────────────────────────────────

model Project {
  id            String  @id @default(cuid())
  reference     String  @unique
  orderId       String?
  orderLineId   String? @unique
  clientId      String
  serviceId     String
  propertyId    String?
  coordinatorId String?
  title         String
  /// Optional cover photo; falls back to the service image.
  coverImageUrl String?

  status           ProjectStatus  @default(AWAITING_INFO)
  /// Status to return to when an ON_HOLD is lifted.
  statusBeforeHold ProjectStatus?
  health           ProjectHealth  @default(ON_TRACK)
  priority         Priority       @default(MEDIUM)
  /// Premium Partner priority-queue flag.
  partnerPriority  Boolean        @default(false)
  /// Free text shown under the current stage on the client overview.
  phaseDescription String?
  phaseNotice      String?
  progress         Int            @default(0)

  fastTrack       Boolean   @default(false)
  turnaroundDays  Int?
  intakeCompleteAt DateTime?
  /// Due-date clock start: intake complete or site visit, whichever is later.
  clockStartAt    DateTime?
  /// Set when a hold is lifted: turnaround restarts from here.
  clockRestartAt  DateTime?
  dueDate         DateTime?

  revisionRoundsIncluded Int @default(2)
  revisionRoundsUsed     Int @default(0)

  compliancePercent   Int     @default(100)
  fundingSecuredPence Int     @default(0)
  scheme              Scheme?
  hasIssues           Boolean @default(false)
  criticalIssue       Boolean @default(false)
  issueSummary        String?

  startedAt            DateTime  @default(now())
  workStartedAt        DateTime?
  deliveredAt          DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  cancellationFeePence Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  client       User               @relation("ProjectClient", fields: [clientId], references: [id])
  coordinator  User?              @relation("ProjectCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  service      Service            @relation(fields: [serviceId], references: [id])
  property     Property?          @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  order        Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderLine    OrderLine?         @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  milestones   ProjectMilestone[]
  tasks        Task[]
  documents    Document[]
  messages     Message[]
  deliverables Deliverable[]
  activities   Activity[]
  visits       Visit[]
  revisions    RevisionRequest[]

  @@index([clientId, status])
  @@index([coordinatorId])
  @@index([status, health])
  @@index([dueDate])
}

model ProjectMember {
  projectId String
  userId    String
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

/// Copy of a ServiceStage for one project (the client timeline).
model ProjectMilestone {
  id            String          @id @default(cuid())
  projectId     String
  stageId       String?
  position      Int
  title         String
  description   String          @default("")
  clientVisible Boolean         @default(true)
  defaultRole   StageRole       @default(COORDINATOR)
  projectStatus ProjectStatus?
  status        MilestoneStatus @default(UPCOMING)
  dueAt         DateTime?
  startedAt     DateTime?
  completedAt   DateTime?

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage   ServiceStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@unique([projectId, position])
}

model Task {
  id              String     @id @default(cuid())
  projectId       String
  title           String
  description     String?
  column          TaskColumn @default(BACKLOG)
  position        Int        @default(0)
  tags            String[]
  visibleToClient Boolean    @default(false)
  assigneeId      String?
  createdById     String?
  milestoneId     String?
  dueDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee  User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, column, position])
  @@index([assigneeId])
}

model Document {
  id             String         @id @default(cuid())
  projectId      String
  uploadedById   String
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String         @unique
  version        Int            @default(1)
  category       String?
  /// ServiceDocumentRequirement.key this upload satisfies.
  requirementKey String?
  status         DocumentStatus @default(PENDING)
  createdAt      DateTime       @default(now())

  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy          User                 @relation(fields: [uploadedById], references: [id])
  deliverables        Deliverable[]
  deliverableVersions DeliverableVersion[]

  @@index([projectId, fileName])
  @@index([projectId, requirementKey])
}

model Message {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([projectId, createdAt])
}

model Deliverable {
  id                   String                   @id @default(cuid())
  projectId            String
  serviceDeliverableId String?
  title                String
  description          String
  kind                 DeliverableKind          @default(PDF)
  status               DeliverableStatus        @default(PENDING)
  versioned            Boolean                  @default(true)
  currentLabel         DeliverableVersionLabel?
  /// Latest issued file (mirrors the newest version).
  documentId           String?
  estimatedAt          DateTime?
  availableAt          DateTime?
  createdAt            DateTime                 @default(now())

  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceDeliverable ServiceDeliverable?  @relation(fields: [serviceDeliverableId], references: [id], onDelete: SetNull)
  document           Document?            @relation(fields: [documentId], references: [id], onDelete: SetNull)
  versions           DeliverableVersion[]

  @@index([projectId])
}

model DeliverableVersion {
  id            String                  @id @default(cuid())
  deliverableId String
  number        Int
  label         DeliverableVersionLabel
  documentId    String
  note          String?
  createdById   String?
  createdAt     DateTime                @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  document    Document    @relation(fields: [documentId], references: [id])

  @@unique([deliverableId, number])
}

model RevisionRequest {
  id            String         @id @default(cuid())
  projectId     String
  round         Int
  note          String
  /// Beyond the included rounds → quoted separately.
  billable      Boolean        @default(false)
  pricePence    Int?
  status        RevisionStatus @default(REQUESTED)
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Activity {
  id        String   @id @default(cuid())
  projectId String
  actorId   String?
  type      String
  message   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

// ─── Platform ───────────────────────────────────────────────────────────────

model EmailTemplate {
  key         String   @id
  subject     String
  html        String
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Typed commercial settings (see src/server/services/settings.ts for keys and defaults).
model Setting {
  key       String   @id
  value     Json
  updatedById String?
  updatedAt DateTime @updatedAt
}

/// Sequential counters for human-readable references (RET-2026-0042, ORD-2026-000123).
model Counter {
  key   String @id
  value Int    @default(0)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
}
